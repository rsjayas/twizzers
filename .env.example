# Copy to .env next to docker-compose.yml: `cp .env.example .env`
# (docker compose reads this file automatically; backend/.env is only for running the API without Docker.)

# Real poems from Claude. Leave empty to get demo text.
ANTHROPIC_API_KEY=

# LOCAL DEVELOPMENT ONLY: lets the mobile app / frontend-demo log in without Firebase.
AUTH_DEV_BYPASS=true

# With a CDN in front: shared secret sent as the X-Origin-Verify header (see docs/SECURITY.md).
# ORIGIN_VERIFY_SECRET=
# Browser origins allowed to call the API, comma separated (checkout page etc.).
# CORS_ORIGINS=

# LOCAL ONLY: the first admin is created on start when none exists (password 10+ characters).
# Change or remove these before any real deployment.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=local-admin-password
# LOCAL ONLY: load placeholder templates, music and credit packs on start (compose default is true).
SEED_ON_START=true

# Admin dashboard token secret (16+ random characters; empty keeps the admin API off).
# First admin: docker compose exec backend python -m app.admin.cli create-admin you@example.com superadmin
ADMIN_JWT_SECRET=local-dev-admin-secret-change-me

# URL your phone/emulator uses to download finished videos from the render service.
# Android emulator: http://10.0.2.2:4000. Real phone: http://<your-computer-LAN-IP>:4000.
RENDER_PUBLIC_URL=http://10.0.2.2:4000

# Shared secret between the API and the render service (change outside local dev).
RENDER_SECRET=dev-render-secret

# Payments stay off until you want to charge.
PAYMENTS_ENABLED=false
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_ENV=sandbox

# Firebase (real login, later)
# FIREBASE_PROJECT_ID=

# Cloudflare R2 for finished videos (optional; local files are used when empty)
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
