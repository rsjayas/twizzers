DATABASE_URL=postgresql://tweezers:tweezers@db:5432/tweezers
ANTHROPIC_API_KEY=your_key_here

# Cashfree Payments (get test keys in the Cashfree merchant dashboard: Developers > API Keys)
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox
# Webhooks are signed with the same client secret. Configure the webhook URL
# (https://yourdomain.com/credits/webhook) in the Cashfree dashboard, or set
# it here to send it with each order.
CASHFREE_NOTIFY_URL=

# How many credits one AI story generation costs (1 credit = Rs 1 by convention)
COST_PER_STORY_CREDITS=5

# Master switch for the whole credits/payments system. While "false":
# story generation is completely free (no credit check, no deduction),
# and the checkout endpoints refuse new purchases. Flip to "true" when
# you're ready to charge - no code changes needed, just redeploy.
PAYMENTS_ENABLED=false
