DATABASE_URL=postgresql://tweezers:tweezers@db:5432/tweezers
# Production uses Neon: copy the connection string from the Neon dashboard, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
ANTHROPIC_API_KEY=your_key_here

# Firebase Auth: the Firebase project ID (Firebase console > Project settings).
# The backend verifies app login tokens against it.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Set when a CDN (CloudFront/Cloudflare) is in front: the API then serves only requests that carry
# this value in an X-Origin-Verify header (configure the same value as a custom origin header
# in the CDN). /health stays open. Leave empty when nothing is in front.
ORIGIN_VERIFY_SECRET=

# Comma separated browser origins allowed to call the API (for example the checkout page).
# Empty means none (except with AUTH_DEV_BYPASS=true, which allows all for local demos).
CORS_ORIGINS=

# Admin dashboard: secret that signs admin login tokens (16+ random characters).
# Leave empty to keep the admin API disabled. Create the first admin with
#   python -m app.admin.cli create-admin you@example.com superadmin
ADMIN_JWT_SECRET=

# LOCAL DEVELOPMENT ONLY: lets frontend-demo log in without Firebase by sending
# "Bearer dev:<user_id>" and enables POST /auth/signup. Keep false everywhere else.
AUTH_DEV_BYPASS=false

# Render service (render-service/). Leave RENDER_SERVICE_URL empty to skip real
# rendering (creations get a placeholder video URL). RENDER_SECRET must match the
# render service's RENDER_SECRET; BACKEND_PUBLIC_URL is how it reaches this API.
RENDER_SERVICE_URL=
RENDER_SECRET=change-me
BACKEND_PUBLIC_URL=http://localhost:8000

# Cashfree Payments (get test keys in the Cashfree merchant dashboard: Developers > API Keys)
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
# "sandbox" for testing, "production" for live payments
CASHFREE_ENV=sandbox
# Webhooks are signed with the same client secret. Configure the webhook URL
# (https://yourdomain.com/credits/webhook) in the Cashfree dashboard, or set
# it here to send it with each order.
CASHFREE_NOTIFY_URL=

# How many credits one AI story generation costs (1 credit = Rs 1 by convention)
COST_PER_STORY_CREDITS=5

# Master switch for the whole credits/payments system. While "false":
# story generation is completely free (no credit check, no deduction),
# and the checkout endpoints refuse new purchases. Flip to "true" when
# you're ready to charge - no code changes needed, just redeploy.
PAYMENTS_ENABLED=false
