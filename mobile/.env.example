# Copy to .env (Expo reads EXPO_PUBLIC_* at build time).
# Android emulator: 10.0.2.2 is your computer. Real phone: your computer's LAN IP or the deployed API.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Public recipient page base (defaults to the API URL).
# EXPO_PUBLIC_SHARE_BASE_URL=
# Hosted web-checkout/credits.html (only needed once payments are on).
# EXPO_PUBLIC_CHECKOUT_URL=
# "dev" needs the backend running with AUTH_DEV_BYPASS=true. "firebase" is not implemented yet.
EXPO_PUBLIC_AUTH_MODE=dev
